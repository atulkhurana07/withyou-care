FIREBASE_PROJECT_ID=demo-withyou
FIREBASE_MODE=emulator
APP_ENV=development
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
DEMO_MODE=true
DEVELOPMENT_CHECKOUT=true
# For cloud: set FIREBASE_MODE=cloud and remove both emulator endpoint variables.
# FIREBASE_PROJECT_ID=your-live-project-id
# FIREBASE_WEB_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/private/path/firebase-service-account.json
# APP_URL=https://your-domain.example
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_MODE=local
# Cloud email requires EMAIL_MODE=resend and a verified EMAIL_FROM domain.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Enable only after approving provider terms and the actual data/billing arrangement.
GEMINI_DATA_APPROVED=false
# Optional controlled free-text extraction. No patient data may be sent without vendor approval.
AI_EXTRACTION_URL=
AI_EXTRACTION_KEY=
