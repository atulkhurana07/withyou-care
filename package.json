{
  "name": "withyou",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/website"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/website",
    "build": "npm run build -w apps/website",
    "start": "npm run start -w apps/website",
    "typecheck": "npm run typecheck -w apps/website",
    "check:production": "node scripts/check-production.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "emulators": "node scripts/start-emulators.mjs",
    "seed": "tsx scripts/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "tokens": "node scripts/generate-tokens.mjs",
    "mobile:preview": "cd apps/patient-mobile && flutter build web --base-href /care-app/ && cd ../.. && node scripts/prepare-mobile-preview.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "firebase-tools": "^14.19.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6"
  },
  "type": "module",
  "overrides": {
    "tar": "7.5.22"
  }
}
